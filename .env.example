# Local development. Use scripts/setup.ps1 to generate a random password.
APP_ENV=development
APP_NAME=WEB-PAYM
# scripts/setup.ps1 replaces this value in .env; never use it in production.
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_USER=paym
POSTGRES_DB=paym
# Use 127.0.0.1 for local Python; Compose uses the postgres host.
POSTGRES_HOST=127.0.0.1
# Host port selected to coexist with other PostgreSQL installations.
POSTGRES_PORT=55432
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Private Vite proxy URL; not included in the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:8000
# Settings reserved for Phase C; authentication is not implemented yet.
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
COOKIE_SECURE=false
